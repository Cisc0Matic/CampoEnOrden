[Unit]
Description=Cloudflare Quick Tunnel for CampoenOrden Django API
After=network-online.target campoenorden.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/francisco/campoenorden/scripts/tunnel_campoenorden.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target